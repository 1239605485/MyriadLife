{
  "pkgId": "liuxin.myriadlife",
  "name": "万灵繁生",
  "author": "liuxin",
  "version": "1.0.14",
  "versionCode": 202609282,
  "brieflyDescribe": "普通生物倍率与 Boss 召唤崩溃诊断。",
  "description": "提高普通生物生成上限，并提供可选的 Boss 召唤入口诊断。诊断不执行 Boss 翻倍；仅支持 Android ARM64。",
  "features": [
    "MECHANICS_CHANGE",
    "QUALITY_OF_LIFE"
  ],
  "sizeCategory": "TINY",
  "targetGameVersion": "1.4.5.8.6",
  "minGameVersion": "1.4.4.0",
  "maxGameVersion": "1.4.5.8.6",
  "support": {
    "android": {
      "arm64": true,
      "arm": false,
      "x64": false,
      "x86": false
    },
    "windows": {
      "arm64": false,
      "arm": false,
      "x64": false,
      "x86": false
    },
    "linux": {
      "arm64": false,
      "arm": false,
      "x64": false,
      "x86": false
    },
    "mac": {
      "arm64": false,
      "arm": false,
      "x64": false,
      "x86": false
    },
    "ios": {
      "arm64": false,
      "arm": false,
      "x64": false,
      "x86": false
    }
  },
  "dependence": [],
  "conflicts": [],
  "stableVerified": false,
  "experimental": true,
  "deprecated": false,
  "hasExtendedContent": false,
  "settings": [
    {
      "key": "enable_normal",
      "title": "启用普通敌怪增强",
      "description": "提高自然生成的普通敌怪数量并缩短生成间隔。",
      "type": "SWITCH",
      "defaultValue": true
    },
    {
      "key": "spawn_multiplier",
      "title": "普通敌怪倍率",
      "description": "普通敌怪生成上限和生成频率倍率。",
      "type": "INTEGER",
      "defaultValue": 5,
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "×"
    },
    {
      "key": "enable_boss",
      "title": "启用 Boss 召唤诊断",
      "description": "只记录 Player.SummonItemCheck 是否触发，不执行翻倍、不绕过召唤限制。用于定位闪退；默认关闭。",
      "type": "SWITCH",
      "defaultValue": false
    },
    {
      "key": "boss_multiplier",
      "title": "Boss 倍率（诊断版不生效）",
      "description": "本诊断版本不执行 Boss 倍率；该设置仅为兼容旧配置保留。",
      "type": "INTEGER",
      "defaultValue": 1,
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "×"
    },
    {
      "key": "enable_event",
      "title": "启用事件敌怪倍率",
      "description": "允许事件敌怪生成时额外生成同类敌怪。",
      "type": "SWITCH",
      "defaultValue": false
    },
    {
      "key": "event_multiplier",
      "title": "事件敌怪倍率",
      "description": "事件及其他非友好、非 Boss 生物的生成倍率。",
      "type": "INTEGER",
      "defaultValue": 5,
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "×"
    },
    {
      "key": "enable_friendly",
      "title": "启用友好生物倍率",
      "description": "允许友好生物和城镇 NPC 生成时额外生成同类生物。",
      "type": "SWITCH",
      "defaultValue": false
    },
    {
      "key": "friendly_multiplier",
      "title": "友好生物倍率",
      "description": "友好生物和城镇 NPC 的生成倍率。",
      "type": "INTEGER",
      "defaultValue": 1,
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "×"
    },
    {
      "key": "enable_total_limit",
      "title": "启用全局生物上限",
      "description": "限制游戏中同时存在的 NPC 总数。游戏底层最多支持 200。",
      "type": "SWITCH",
      "defaultValue": false
    },
    {
      "key": "total_npc_limit",
      "title": "全局生物总上限",
      "description": "游戏中同时存在的 NPC 总数上限。",
      "type": "INTEGER",
      "defaultValue": 200,
      "min": 20,
      "max": 200,
      "step": 1,
      "unit": "个"
    }
  ]
}
